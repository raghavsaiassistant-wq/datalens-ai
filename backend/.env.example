# ==============================================================================
# DataLens AI — Environment Variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to git.
# ==============================================================================

# ── REQUIRED: Ollama Cloud API key ───────────────────────────────────────────
# Get your free key at: https://ollama.com/settings/keys
# Single key covers all 33 cloud chat models. No expiry, no per-model keys.
OLLAMA_API_KEY=<get-from-ollama.com-settings-keys>

# ── Ollama Cloud endpoint (override only for local testing) ──────────────────
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_LOCAL_URL=http://localhost:11434  # for local embeddings

# ── App config ───────────────────────────────────────────────────────────────
FLASK_ENV=production
MAX_FILE_SIZE_MB=25
JOB_TTL_SECONDS=3600
UPLOAD_FOLDER=/tmp/datalens_uploads
PORT=5000

# ── Smart sampling (v1.1: also expose as user-toggleable) ────────────────────
SAMPLE_MAX_ROWS_FOR_AI=500
SAMPLE_MAX_ROWS_FOR_DISPLAY=30000
